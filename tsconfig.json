{
  "compileOnSave": false,
  "compilerOptions": {
    "baseUrl": "./",
    "outDir": "./dist/out-tsc",
    "sourceMap": true,
    "declaration": false,
    "module": "esnext",
    "moduleResolution": "node",
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es5",
    "paths": {
      "@environments/*": ["src/environments/*"]
    },
    "typeRoots": ["node_modules/@types"],
    "lib": ["es2019", "dom"]
  },
  "angularCompilerOptions": {
    // "enableIvy": false,
    "fullTemplateTypeCheck": true,
    "strictInjectionParameters": true
  }
}
